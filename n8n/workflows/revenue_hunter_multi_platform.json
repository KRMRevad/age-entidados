        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst results = [];\nconst seen = new Set();\n\nfor (const item of items) {\n  if (!item || !item.json) continue;\n  const titles = Array.isArray(item.json.titles) ? item.json.titles : [item.json.titles].filter(Boolean);\n  const links = Array.isArray(item.json.links) ? item.json.links : [item.json.links].filter(Boolean);\n  const budgets = Array.isArray(item.json.budgets) ? item.json.budgets : [item.json.budgets].filter(Boolean);\n  const skills = Array.isArray(item.json.skills) ? item.json.skills : [item.json.skills].filter(Boolean);\n  \n  // Identify platform based on link presence\n  const isWorkana = links.some(l => l && typeof l === 'string' && l.includes('workana')) || (!links.length && item.json.titles && item.json.titles.length > 0);\n  const is99 = links.some(l => l && typeof l === 'string' && l.includes('99freelas'));\n  \n  let platform = 'workana';\n  let badge = 'WKN';\n  if (is99 || (!isWorkana && titles.length && links.some(l => l.startsWith('/projects')))) {\n    platform = '99freelas';\n    badge = '99F';\n  }\n  \n  const maxItems = Math.min(titles.length, links.length);\n  \n  for (let i = 0; i < maxItems; i++) {\n    if (!titles[i]) continue;\n    const title = String(titles[i]).trim();\n    if (title.length < 5) continue;\n    \n    const hash = title.toLowerCase().replace(/\\s+/g, '');\n    if (seen.has(hash)) continue;\n    seen.add(hash);\n    \n    const budgetText = budgets[i] ? String(budgets[i]).trim() : '';\n    const nums = (budgetText.match(/\\d+/g) || []).map(Number);\n    const rewardMin = nums.length >= 2 ? nums[0] : 0;\n    const rewardMax = nums.length >= 2 ? nums[1] : (nums[0] || 0);\n    \n    let url = links[i] ? String(links[i]) : '';\n    if (url.startsWith('/')) {\n      url = (platform === 'workana' ? 'https://www.workana.com' : 'https://www.99freelas.com.br') + url;\n    }\n    \n    let effortHours = 10;\n    if (rewardMax <= 100) effortHours = 4;\n    else if (rewardMax <= 250) effortHours = 8;\n    else if (rewardMax <= 500) effortHours = 15;\n    else if (rewardMax <= 1000) effortHours = 25;\n    else effortHours = 40;\n    \n    const ourSkills = ['python','ia','chatbot','whatsapp','automa\u00e7\u00e3o','automation','node','react','api','n8n','openai','gpt','llm','machine learning','nlp','bot'];\n    const titleLower = title.toLowerCase();\n    let skillMatch = ourSkills.filter(s => titleLower.includes(s)).length;\n    \n    let skillText = '';\n    if (skills[i] && typeof skills[i] === 'string') {\n      skillText = skills[i].replace(/[\\n\\r]+/g, ', ').trim();\n      skillMatch += ourSkills.filter(s => skillText.toLowerCase().includes(s)).length;\n    }\n    \n    const ratio = rewardMax / Math.max(effortHours, 1);\n    const score = Math.round(ratio * 0.6 + skillMatch * 25 * 0.4);\n    \n    let tier = 'cool';\n    if (score > 40 || skillMatch >= 2) tier = 'hot';\n    else if (score > 15 || skillMatch >= 1) tier = 'warm';\n    \n    results.push({\n      json: {\n        id: `${badge.toLowerCase()}_${Date.now()}_${i}`,\n        platform,\n        title,\n        url,\n        rewardMin,\n        rewardMax,\n        effortHours,\n        skills: skillText,\n        tier,\n        score,\n        status: 'active',\n        posted: new Date().toISOString(),\n        scraped_at: new Date().toISOString()\n      }\n    });\n  }\n}\n\nresults.sort((a, b) => b.json.score - a.json.score);\nreturn results;"
            },
